generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  draft
  processing
  composing
  completed
  failed
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  credits       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  videos        Video[]
  templates     Template[]
  supabaseId    String?   @unique
  subscriptionStatus String?
  subscriptionId String?
  subscriptionTier String?
  subscriptionCurrentPeriodEnd DateTime?
  creditTransactions CreditTransaction[]
  transactions       Transaction[]
  studios            Studio[]

  @@map("users")
}

model Video {
  id            String    @id @default(cuid())
  title         String
  description   String?
  videoUrl      String?
  thumbnailUrl  String?
  captionStyle  String?   // Optional field as requested
  tags          String?   // Optional field as requested
  duration      Int?
  status        VideoStatus @default(draft)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId    String?
  template      Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creditCost    Int       @default(0)
  progress      Int       @default(0)
  metadata      Json?
  error         String?
  prompt        String?
  narration     String?   // voiceover script; falls back to `prompt` if not set
  aspectRatio   String?
  style         String?
  resolution    String?
  jobId         String?   @unique
  studioId      String?
  studio        Studio?   @relation(fields: [studioId], references: [id], onDelete: SetNull)

  @@map("videos")
}

model Studio {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  type              String        // e.g. "trading", "ufc", or a freeform label
  description       String?
  stylePrompt       String?       // reusable style/voice guidance applied to every generation in this studio
  aspectRatio       String        @default("9:16")
  dailyGeneration   Boolean       @default(false)
  dailyPrompt       String?       // prompt template used for automatic daily generation
  lastGeneratedAt   DateTime?
  assets            StudioAsset[]
  videos            Video[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("studios")
}

model StudioAsset {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  type      String   // "image" | "link"
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@map("studio_assets")
}

model Template {
  id            String    @id @default(cuid())
  name          String
  description   String?
  thumbnailUrl  String?
  captionStyle  String?   // Optional field as requested
  tags          String?   // Optional field as requested
  config        Json      // Store template configuration as JSON
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos        Video[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      String?
  duration      Int?
  aspectRatio   String?
  previewUrl    String?
  examplePrompt String?
  isPublic      Boolean   @default(false)

  @@map("templates")
}

model CreditTransaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  description   String?
  balanceAfter  Int
  createdAt     DateTime  @default(now())

  @@map("credit_transactions")
}

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  amount        Int
  description   String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  @@map("transactions")
}
