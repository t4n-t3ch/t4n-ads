generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

enum VideoStatus {
  draft
  processing
  completed
  failed

  @@schema("app")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  name          String?
  credits       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  videos        Video[]
  templates     Template[]
  supabaseId    String?   @unique
  subscriptionStatus String?
  subscriptionId String?
  subscriptionTier String?
  subscriptionCurrentPeriodEnd DateTime?
  creditTransactions CreditTransaction[]
  transactions       Transaction[]
  subjects           Subject[]
  automations        Automation[]

  @@map("users")
  @@schema("app")
}

model Video {
  id            String    @id @default(cuid())
  title         String
  description   String?
  videoUrl      String?
  thumbnailUrl  String?
  captionStyle  String?   // Optional field as requested
  tags          String?   // Optional field as requested
  duration      Int?
  status        VideoStatus @default(draft)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId    String?
  template      Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creditCost    Int       @default(0)
  progress      Int       @default(0)
  metadata      Json?
  error         String?
  prompt        String?
  aspectRatio   String?
  style         String?
  resolution    String?
  jobId         String?   @unique
  subjectId     String?
  subject       Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  costCents     Int?      // actual OpenRouter cost for this generation, in US cents
  isOutro       Boolean   @default(false) // appended to the end of every other completed video for this user
  appendOutro   Boolean   @default(true)  // whether THIS video should have the account's outro appended

  @@map("videos")
  @@schema("app")
}

model Template {
  id            String    @id @default(cuid())
  name          String
  description   String?
  thumbnailUrl  String?
  captionStyle  String?   // Optional field as requested
  tags          String?   // Optional field as requested
  config        Json      // Store template configuration as JSON
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos        Video[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      String?
  duration      Int?
  aspectRatio   String?
  previewUrl    String?
  examplePrompt String?
  isPublic      Boolean   @default(false)

  @@map("templates")
  @@schema("app")
}

model CreditTransaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  description   String?
  balanceAfter  Int
  createdAt     DateTime  @default(now())

  @@map("credit_transactions")
  @@schema("app")
}

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  amount        Int
  description   String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  @@map("transactions")
  @@schema("app")
}

model Subject {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  photos      SubjectPhoto[]
  videos      Video[]
  automations Automation[]

  @@map("subjects")
  @@schema("app")
}

model SubjectPhoto {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@map("subject_photos")
  @@schema("app")
}

model Automation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name           String
  // "fixed": promptTemplate reused every run. "ai_varied": styleGoal is
  // given to an LLM to write a fresh prompt each run.
  promptMode     String
  promptTemplate String?
  styleGoal      String?
  // comma-separated day-of-week ints, 0 (Sun) - 6 (Sat)
  daysOfWeek     String
  aspectRatio    String   @default("16:9")
  duration       Int      @default(8)
  enabled        Boolean  @default(true)
  appendOutro    Boolean  @default(true) // whether runs of this automation get the account's outro appended
  // "YYYY-MM-DD" (UTC) of the last run, so the daily cron tick doesn't
  // generate twice for the same day.
  lastRunDate    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("automations")
  @@schema("app")
}
